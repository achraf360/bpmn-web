<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.6.1">
  <bpmn:collaboration id="Collaboration_01uem2o">
    <bpmn:participant id="Participant_0wefln0" processRef="Process_OPEX" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OPEX" isExecutable="true" camunda:candidateStarterGroups="ACHAT">
    <bpmn:startEvent id="StartEvent_1" name="Début" camunda:initiator="requester" camunda:candidateGroups="ACHAT">
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Achat" name="Saisir Bon de Commande&#10; ( OPEX )" camunda:assignee="$data.requester" camunda:candidateGroups="ACHAT">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">item.vars.sendNotif=false;</camunda:script>
        </camunda:executionListener>
        <camunda:taskListener event="validate">
          <camunda:script scriptFormat="JavaScript">item.vars=item.input;</camunda:script>
        </camunda:taskListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.subject=this.data.number;</camunda:script>
        </camunda:executionListener>
        <camunda:formData>
          <camunda:formField id="number" label="Numéro" type="string" />
          <camunda:formField id="amount" label="Montant" type="long" />
          <camunda:formField id="image" label="Bon de commande" type="file" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DAF" name="Approbation DGA" camunda:candidateGroups="DAF" camunda:dueDate="$this.dueDate">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="validationDAF" label="Validation" type="validation">
            <camunda:properties>
              <camunda:property id="actions" value="approve,reject,require_info" />
              <camunda:property id="type" value="radio_button" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="comment_daf" label="commentaire" type="text" />
        </camunda:formData>
        <camunda:taskListener event="validate">
          <camunda:script scriptFormat="JavaScript">item.vars=item.input;</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_RefusDAF" name="Fin - Refus DAF">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.endDate=this.endedAt;</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>FlowRefusDAF</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OK" name="Fin - Approbation OK">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.endDate=this.endedAt;</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Notification" name="Envoyer Notification + Email">
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow9" sourceRef="Task_Notification" targetRef="End_OK" />
    <bpmn:sequenceFlow id="Flow8" name="Approved" sourceRef="Gateway_CDG" targetRef="Task_Notification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validation_CDG=="approve")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowRefusCDG" name="decline" sourceRef="Gateway_CDG" targetRef="End_RefusCDG">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validation_CDG=="decline")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow7" name="CDG approuve ?" sourceRef="validation_CDG" targetRef="Gateway_CDG" />
    <bpmn:sequenceFlow id="Flow6" sourceRef="Gateway_Montant" targetRef="validation_CDG">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.amount&lt;100000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow5" name="Montant élevé" sourceRef="Gateway_Montant" targetRef="End_Montant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.amount&gt;100000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_validated" name="Approved" sourceRef="Gateway_DAF" targetRef="Gateway_Montant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validationDAF=="approve")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowRefusDAF" name="decline" sourceRef="Gateway_DAF" targetRef="End_RefusDAF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validationDAF=="decline")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow3" sourceRef="Task_DAF" targetRef="Gateway_DAF" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="Task_Achat" targetRef="Task_DAF" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="StartEvent_1" targetRef="Task_Achat" />
    <bpmn:userTask id="validation_CDG" name="Approbation CDG" camunda:formKey="Form_CDG" camunda:candidateGroups="CDG">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="validation_cdg" label="Validation" type="validation" />
        </camunda:formData>
        <camunda:taskListener event="validate">
          <camunda:script scriptFormat="JavaScript">item.vars=item.input;</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Montant" name="Montant &#62; 100000 ?">
      <bpmn:incoming>Flow_validated</bpmn:incoming>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_DAF" name="DGA approuve ?">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>FlowRefusDAF</bpmn:outgoing>
      <bpmn:outgoing>Flow_validated</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CDG" name="CDG approuve ?">
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:outgoing>FlowRefusCDG</bpmn:outgoing>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RefusCDG" name="Fin - Refus CDG">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.endDate=this.endedAt;</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>FlowRefusCDG</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Montant" name="Fin - Montant élevé">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.endDate=this.endedAt;</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
