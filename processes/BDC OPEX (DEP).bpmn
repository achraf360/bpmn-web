    <bpmn:userTask id="validationDGA_BDC" name="Approbation interne DGA ou Dir Dépt" camunda:candidateGroups="DGA_BDC">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="validationDGA" label="Validation" type="validation">
            <camunda:properties>
              <camunda:property id="actions" value="approve,reject" />
              <camunda:property id="type" value="radio_button" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="commentDGA" label="Commentaire" type="string" />
        </camunda:formData>
        <camunda:taskListener event="validate">
          <camunda:script scriptFormat="JavaScript">item.vars=item.input;</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ci7ff8</bpmn:incoming>
      <bpmn:outgoing>Flow_13f3x2e</bpmn:outgoing>
      <bpmn:outgoing>Flow_14dmdj1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ValidationCDG" name="Approbation CDG (CEO)" camunda:candidateGroups="CDG">
