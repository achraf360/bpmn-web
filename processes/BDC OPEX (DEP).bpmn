    <bpmn:userTask id="Activity_Init_Request" name="Initiation collaborateur : Création BC OPEX" camunda:assignee="$data.requester" camunda:candidateGroups="COLLAB_BC">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="BDC_OPEX" label="Bon de commande" type="file" />
          <camunda:formField id="purchaseDescription" label="Descriptif d&#39;achat" type="string">
            <camunda:properties>
              <camunda:property id="is_required" value="true" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="amount" label="Montant" type="long" />
          <camunda:formField id="supplierName" label="Nom Fournisseur" type="string" />
          <camunda:formField id="site" label="Site" type="string" />
          <camunda:formField id="commentinit_task" label="Commentaire" type="text" />
        </camunda:formData>
        <camunda:taskListener event="validate">
          <camunda:script scriptFormat="JavaScript">item.vars=item.input;</camunda:script>
        </camunda:taskListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">data.subject=this.data.purchaseDescription;</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06iowmq</bpmn:incoming>
      <bpmn:outgoing>Flow_0ci7ff8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0zuek2x" sourceRef="Notification_DAF" targetRef="Event_02g6vzt" />
    <bpmn:sequenceFlow id="Flow_0zbkk8m" name="Oui" sourceRef="ValidationCDG" targetRef="Notification_DAF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.ValidationCDG=="approve")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11pg1zv" name="Non" sourceRef="ValidationCDG" targetRef="Event_1jvrq2e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.ValidationCDG=="reject")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_00bdysz" name="Non" sourceRef="Gateway_inf_100000" targetRef="ValidationCDG">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.amount&gt;100000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0lllafj" name="Oui" sourceRef="Gateway_inf_100000" targetRef="Event_09rtj6f">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.amount&lt;100000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14dmdj1" name="Oui" sourceRef="validationDGA_BDC" targetRef="Gateway_inf_100000">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validationDGA=="approve")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13f3x2e" name="Non" sourceRef="validationDGA_BDC" targetRef="Event_19u260l">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript">$(item.data.validationDGA=="reject")</bpmn:conditionExpression>
