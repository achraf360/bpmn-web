<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Purchase_Request" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ACHAT" name="ACHAT">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CDG" name="CDG">
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supplier</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnterAmount" name="Enter Amount (ACHAT)">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Confirm" name="Confirm (CDG)">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Approval" name="Approved?">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Supplier" name="Proceed to Supplier">
      <bpmn:incoming>Flow4</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Notify" name="Notify ACHAT">
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:incoming>Flow7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow1" sourceRef="StartEvent_1" targetRef="Task_EnterAmount"/>
    <bpmn:sequenceFlow id="Flow2" sourceRef="Task_EnterAmount" targetRef="Task_Confirm"/>
    <bpmn:sequenceFlow id="Flow3" sourceRef="Task_Confirm" targetRef="Gateway_Approval"/>
    <bpmn:sequenceFlow id="Flow4" sourceRef="Gateway_Approval" targetRef="Task_Supplier" name="Yes"/>
    <bpmn:sequenceFlow id="Flow5" sourceRef="Gateway_Approval" targetRef="Task_Notify" name="No"/>
    <bpmn:sequenceFlow id="Flow6" sourceRef="Task_Supplier" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="Flow7" sourceRef="Task_Notify" targetRef="EndEvent_1"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Purchase_Request">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Enter Amount Task -->
      <bpmndi:BPMNShape id="Task_EnterAmount_di" bpmnElement="Task_EnterAmount">
        <dc:Bounds x="180" y="85" width="100" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Confirm Task -->
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="320" y="85" width="100" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Gateway -->
      <bpmndi:BPMNShape id="Gateway_Approval_di" bpmnElement="Gateway_Approval" isMarkerVisible="true">
        <dc:Bounds x="460" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Proceed to Supplier -->
      <bpmndi:BPMNShape id="Task_Supplier_di" bpmnElement="Task_Supplier">
        <dc:Bounds x="550" y="50" width="100" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Notify ACHAT -->
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="550" y="140" width="100" height="50"/>
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="680" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Flow1_di" bpmnElement="Flow1">
        <di:waypoint x="136" y="118"/>
        <di:waypoint x="180" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow2_di" bpmnElement="Flow2">
        <di:waypoint x="280" y="110"/>
        <di:waypoint x="320" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow3_di" bpmnElement="Flow3">
        <di:waypoint x="420" y="110"/>
        <di:waypoint x="460" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow4_di" bpmnElement="Flow4">
        <di:waypoint x="510" y="120"/>
        <di:waypoint x="550" y="75"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow5_di" bpmnElement="Flow5">
        <di:waypoint x="485" y="145"/>
        <di:waypoint x="550" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow6_di" bpmnElement="Flow6">
        <di:waypoint x="650" y="75"/>
        <di:waypoint x="680" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow7_di" bpmnElement="Flow7">
        <di:waypoint x="650" y="165"/>
        <di:waypoint x="680" y="118"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
